# LGTM OS boot splash (Plymouth script theme). Graphite background, logo, a ring of
# dots while booting, and a frosted password box when the disk needs unlocking.

Window.SetBackgroundTopColor(0.118, 0.118, 0.118);
Window.SetBackgroundBottomColor(0.090, 0.090, 0.098);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 40, 1);

dot = Image("dot.png");
for (i = 0; i < 8; i++)
  dots[i] = Sprite(dot);

entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.sprite.SetPosition(cx - entry.image.GetWidth() / 2, cy + 70, 3);
entry.sprite.SetOpacity(0);

prompt.sprite = Sprite();
prompt.sprite.SetOpacity(0);
bullets.sprite = Sprite();
bullets.sprite.SetOpacity(0);
message.sprite = Sprite();

global.asking = 0;
global.tick = 0;

fun refresh_callback() {
  global.tick++;
  step = Math.Int(global.tick / 5) % 8;
  for (i = 0; i < 8; i++) {
    a = i * Math.Pi / 4;
    dots[i].SetPosition(cx + 16 * Math.Cos(a) - dot.GetWidth() / 2,
                        cy + 100 + 16 * Math.Sin(a) - dot.GetHeight() / 2, 2);
    age = (step - i + 8) % 8;
    if (global.asking)
      dots[i].SetOpacity(0);
    else
      dots[i].SetOpacity(1 - age / 8);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun display_password_callback(prompt_text, bullet_count) {
  global.asking = 1;
  entry.sprite.SetOpacity(1);
  if (prompt_text == "") prompt_text = "Enter your password to unlock";
  p = Image.Text(prompt_text, 0.96, 0.96, 0.97, 1, "Inter 11");
  prompt.sprite.SetImage(p);
  prompt.sprite.SetPosition(cx - p.GetWidth() / 2, cy + 44, 3);
  prompt.sprite.SetOpacity(1);
  s = "";
  for (i = 0; i < bullet_count && i < 24; i++) s += "•";
  if (s == "") s = " ";
  b = Image.Text(s, 1, 1, 1, 1, "Inter 14");
  bullets.sprite.SetImage(b);
  bullets.sprite.SetPosition(cx - b.GetWidth() / 2,
                             cy + 70 + entry.image.GetHeight() / 2 - b.GetHeight() / 2, 4);
  bullets.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  global.asking = 0;
  entry.sprite.SetOpacity(0);
  prompt.sprite.SetOpacity(0);
  bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text) {
  m = Image.Text(text, 0.7, 0.7, 0.72, 1, "Inter 10");
  message.sprite.SetImage(m);
  message.sprite.SetPosition(cx - m.GetWidth() / 2, Window.GetY() + Window.GetHeight() - 60, 5);
}
Plymouth.SetMessageFunction(message_callback);
