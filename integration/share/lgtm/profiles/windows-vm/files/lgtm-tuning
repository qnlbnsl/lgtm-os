#!/usr/bin/env python3
"""libvirt qemu hook for VMs made by lgtm-vm (they carry <lgtm:vm tuning="yes"/>).

While such a VM runs:
  - its RAM is backed by 2 MiB hugepages, reserved at start and freed at shutdown
    (4 KiB pages cost 10-30% on memory-heavy work);
  - host processes, kernel workqueues and IRQs stay off the CPUs its vCPUs are pinned to.
libvirt passes the domain XML on stdin. Other VMs are left alone.
"""
import subprocess, sys, xml.etree.ElementTree as ET

NS = "https://github.com/qnlbnsl/lgtm-os/vm"


def w(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(value))
        return True
    except OSError:
        return False


def cpus(spec):
    out = set()
    for part in spec.split(","):
        a, _, b = part.partition("-")
        out.update(range(int(a), int(b or a) + 1))
    return out


def fmt(s):
    s, out, i = sorted(s), [], 0
    while i < len(s):
        j = i
        while j + 1 < len(s) and s[j + 1] == s[j] + 1:
            j += 1
        out.append(f"{s[i]}-{s[j]}" if j > i else str(s[i]))
        i = j + 1
    return ",".join(out)


def mask(s):
    return format(sum(1 << c for c in s), "x")


def place(host):
    for unit in ("user.slice", "system.slice", "init.scope"):
        subprocess.run(["systemctl", "set-property", "--runtime", unit, f"AllowedCPUs={fmt(host)}"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    w("/sys/devices/virtual/workqueue/cpumask", mask(host))
    import glob
    for f in glob.glob("/proc/irq/*/smp_affinity_list"):
        w(f, fmt(host))   # some IRQs can't move; that's fine


def main():
    if len(sys.argv) < 4:
        return 0
    op = f"{sys.argv[2]}/{sys.argv[3]}"
    try:
        dom = ET.fromstring(sys.stdin.read())
    except ET.ParseError:
        return 0
    meta = dom.find(f"metadata/{{{NS}}}vm")
    if meta is None or meta.get("tuning") != "yes":
        return 0
    online = cpus(open("/sys/devices/system/cpu/online").read().strip())
    vm = set()
    for p in dom.findall("cputune/vcpupin"):
        vm |= cpus(p.get("cpuset"))
    huge = dom.find("memoryBacking/hugepages") is not None
    mem = dom.find("memory")
    kib = int(mem.text) * {"KiB": 1, "MiB": 1024, "GiB": 1024 ** 2}.get(mem.get("unit", "KiB"), 1)
    pages = kib // 2048

    if op == "prepare/begin" and huge:
        subprocess.run(["sync"])
        w("/proc/sys/vm/drop_caches", 3)
        w("/proc/sys/vm/compact_memory", 1)
        w("/proc/sys/vm/nr_hugepages", pages)
        got = int(open("/proc/sys/vm/nr_hugepages").read())
        if got < pages:
            w("/proc/sys/vm/nr_hugepages", 0)
            print(f"lgtm-tuning: only {got}/{pages} hugepages free; close some apps or give "
                  f"the VM less memory (lgtm-vm edit)", file=sys.stderr)
            return 1
    elif op == "started/begin" and vm and online - vm:
        place(online - vm)
    elif op == "release/end":
        if vm:
            place(online)
        if huge:
            w("/proc/sys/vm/nr_hugepages", 0)
    return 0


if __name__ == "__main__":
    sys.exit(main())
