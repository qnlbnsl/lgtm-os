[Unit]
Description=Notice program crashes (inotify watch, no running process)
# The crash-reports feature watches the journal instead (lgtm-crash-watch.service).
ConditionPathExists=!/etc/lgtm/features/crash-reports

[Path]
PathChanged=/var/lib/systemd/coredump
Unit=lgtm-crash.service

[Install]
WantedBy=default.target
