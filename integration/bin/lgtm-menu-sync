#!/usr/bin/env python3
"""lgtm-menu-sync: turn Windows Start Menu shortcuts into app menu entries.

Scans each prefix's Start Menu for .lnk files, resolves the target .exe,
extracts its icon, and writes a .desktop file that starts it with lgtm-exe.
Removes entries whose program has been uninstalled.

    lgtm-menu-sync [--prefix PATH]   (default: all prefixes)
"""
import argparse
import hashlib
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
DATA = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
BASE = DATA / "lgtm/windows"
APPS = DATA / "applications/lgtm"
ICONS = DATA / "lgtm/icons"

SKIP = re.compile(r"uninstall|uninst|remove|readme|help|license|website|manual|release notes",
                  re.I)


# ---- .lnk parsing (MS-SHLLINK) ---------------------------------------------

def parse_lnk(data: bytes) -> dict:
    """Return the target path, relative path and arguments from a .lnk file."""
    if len(data) < 0x4C or struct.unpack_from("<I", data, 0)[0] != 0x4C:
        return {}
    flags = struct.unpack_from("<I", data, 0x14)[0]
    pos = 0x4C
    out = {}
    if flags & 0x01:  # HasLinkTargetIDList
        pos += 2 + struct.unpack_from("<H", data, pos)[0]
    if flags & 0x02:  # HasLinkInfo
        start = pos
        size, hdr, li_flags, _vol, base_off = struct.unpack_from("<IIIII", data, pos)
        _net, suffix_off = struct.unpack_from("<II", data, pos + 20)
        if li_flags & 0x01:
            if hdr >= 0x24:
                uoff = struct.unpack_from("<I", data, pos + 28)[0]
                out["target"] = _wstr(data, start + uoff)
            else:
                out["target"] = _astr(data, start + base_off) + _astr(data, start + suffix_off)
        pos = start + size
    unicode = bool(flags & 0x80)
    for bit, key in ((0x04, "name"), (0x08, "relative"), (0x10, "workdir"),
                     (0x20, "args"), (0x40, "icon")):
        if flags & bit:
            count = struct.unpack_from("<H", data, pos)[0]
            pos += 2
            n = count * 2 if unicode else count
            raw = data[pos:pos + n]
            out[key] = raw.decode("utf-16-le" if unicode else "cp1252", "replace")
            pos += n
    # ExtraData: EnvironmentVariableDataBlock (target written as %ProgramFiles%\...)
    while pos + 8 <= len(data):
        bsize, sig = struct.unpack_from("<II", data, pos)
        if bsize < 4:
            break
        if sig == 0xA0000001 and "target" not in out:
            out["target"] = _wstr(data, pos + 8 + 260)
        pos += bsize
    return out


def _astr(data, off):
    end = data.index(b"\0", off)
    return data[off:end].decode("cp1252", "replace")


def _wstr(data, off):
    end = off
    while end + 1 < len(data) and data[end:end + 2] != b"\0\0":
        end += 2
    return data[off:end].decode("utf-16-le", "replace")


# ---- path helpers -----------------------------------------------------------

def drive_c(prefix: Path) -> Path | None:
    for c in (prefix / "drive_c", prefix / "pfx/drive_c"):
        if c.is_dir():
            return c
    return None


def ci_resolve(root: Path, parts) -> Path | None:
    """Resolve a path case-insensitively, as Windows does."""
    cur = root
    for part in parts:
        if not part:
            continue
        nxt = cur / part
        if not nxt.exists():
            try:
                match = next((e for e in cur.iterdir() if e.name.lower() == part.lower()), None)
            except OSError:
                return None
            if match is None:
                return None
            nxt = match
        cur = nxt
    return cur


ENV = {
    "%programfiles%": "C:\\Program Files",
    "%programfiles(x86)%": "C:\\Program Files (x86)",
    "%systemroot%": "C:\\windows",
    "%windir%": "C:\\windows",
}


def win_to_unix(prefix: Path, winpath: str) -> Path | None:
    c = drive_c(prefix)
    if c is None or not winpath:
        return None
    p = winpath
    for k, v in ENV.items():
        p = re.sub(re.escape(k), lambda _m, v=v: v, p, flags=re.I)
    m = re.match(r"^([A-Za-z]):\\(.*)$", p)
    if not m:
        return None
    if m.group(1).lower() == "c":
        return ci_resolve(c, m.group(2).split("\\"))
    # Other drive letters: follow the prefix's dosdevices links.
    dev = c.parent / "dosdevices" / f"{m.group(1).lower()}:"
    return ci_resolve(dev.resolve(), m.group(2).split("\\")) if dev.exists() else None


def start_menus(prefix: Path):
    c = drive_c(prefix)
    if c is None:
        return
    yield c / "ProgramData/Microsoft/Windows/Start Menu/Programs"
    users = c / "users"
    if users.is_dir():
        for u in users.iterdir():
            yield u / "AppData/Roaming/Microsoft/Windows/Start Menu/Programs"
            yield u / "Start Menu/Programs"


# ---- icons ------------------------------------------------------------------

def extract_icon(exe: Path, key: str) -> str:
    ICONS.mkdir(parents=True, exist_ok=True)
    png = ICONS / f"{key}.png"
    if png.exists():
        return str(png)
    if not (shutil.which("wrestool") and shutil.which("icotool")) or exe.suffix.lower() != ".exe":
        return "application-x-executable"
    with tempfile.TemporaryDirectory() as td:
        ico = Path(td) / "icon.ico"
        with open(ico, "wb") as f:
            r = subprocess.run(["wrestool", "-x", "-t", "14", str(exe)], stdout=f,
                               stderr=subprocess.DEVNULL)
        if r.returncode != 0 or ico.stat().st_size == 0:
            return "application-x-executable"
        subprocess.run(["icotool", "-x", "-o", td, str(ico)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        pngs = sorted(Path(td).glob("*.png"), key=lambda p: p.stat().st_size)
        if not pngs:
            return "application-x-executable"
        shutil.copy(pngs[-1], png)
    return str(png)


# ---- .desktop writing -------------------------------------------------------

def desktop_quote(arg: str) -> str:
    arg = arg.replace("\\", "\\\\").replace('"', '\\"').replace("`", "\\`").replace("$", "\\$")
    return '"' + arg.replace("%", "%%") + '"'


def sync_prefix(prefix: Path, keep: set):
    seen = set()
    for menu in start_menus(prefix):
        if not menu.is_dir():
            continue
        for lnk in menu.rglob("*"):
            if lnk.suffix.lower() != ".lnk" or SKIP.search(lnk.stem):
                continue
            try:
                info = parse_lnk(lnk.read_bytes())
            except (OSError, struct.error, ValueError):
                continue
            exe = win_to_unix(prefix, info.get("target", ""))
            if exe is None and info.get("relative"):
                exe = ci_resolve(lnk.parent, info["relative"].split("\\"))
            if exe is None or not exe.is_file() or exe.suffix.lower() not in (".exe", ".bat", ".msc"):
                continue
            key = f"{prefix.name}-" + hashlib.sha1(str(exe).encode()).hexdigest()[:12]
            if key in seen:
                continue
            seen.add(key)
            keep.add(key)
            icon = extract_icon(exe, key)
            exec_line = " ".join(desktop_quote(a) for a in
                                 ["lgtm-exe", "--prefix", prefix.name, str(exe)])
            args = info.get("args", "").strip()
            if args:
                exec_line += " " + " ".join(desktop_quote(a) for a in args.split())
            name = lnk.stem.replace("\n", " ")
            entry = (
                "[Desktop Entry]\n"
                "Type=Application\n"
                f"Name={name}\n"
                f"Exec={exec_line}\n"
                f"Icon={icon}\n"
                "Categories=Wine;\n"
                f"StartupWMClass={exe.name.lower()}\n"
                f"X-LGTM-Target={exe}\n"
                f"X-LGTM-Prefix={prefix.name}\n"
            )
            path = APPS / f"{key}.desktop"
            if not path.exists() or path.read_text(errors="replace") != entry:
                path.write_text(entry)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--prefix", type=Path)
    a = ap.parse_args()
    APPS.mkdir(parents=True, exist_ok=True)
    prefixes = [a.prefix] if a.prefix else (sorted(p for p in BASE.iterdir() if p.is_dir())
                                            if BASE.is_dir() else [])
    keep = set()
    for p in prefixes:
        sync_prefix(p.resolve(), keep)
    # Remove entries for uninstalled programs (only within the prefixes we scanned).
    scanned = {p.name for p in prefixes}
    for d in APPS.glob("*.desktop"):
        txt = d.read_text(errors="replace")
        pm = re.search(r"^X-LGTM-Prefix=(.*)$", txt, re.M)
        if pm and pm.group(1) in scanned and d.stem not in keep:
            d.unlink()
            (ICONS / f"{d.stem}.png").unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
