#!/usr/bin/env bash
# lgtm-screenshot full|region: save to ~/Pictures/Screenshots and copy to the clipboard.
set -euo pipefail
dir=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots
mkdir -p "$dir"
file=$dir/"Screenshot $(date '+%Y-%m-%d at %H.%M.%S').png"
case ${1:-region} in
  full)   grim "$file" ;;
  region) area=$(slurp -d -b 00000066 -c ffffffcc -w 1) || exit 0; grim -g "$area" "$file" ;;
  *) echo "usage: lgtm-screenshot full|region" >&2; exit 2 ;;
esac
wl-copy --type image/png < "$file"
notify-send -a "LGTM OS" -i "$file" "Screenshot saved" "Copied to the clipboard. ${file/#$HOME/~}" 2>/dev/null || true
