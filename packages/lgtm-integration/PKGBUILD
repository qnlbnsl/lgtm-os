# LGTM OS's own glue: Windows/Android/Mac launchers, session, look, tuning.
pkgname=lgtm-integration
pkgver=0.1.0
pkgrel=1
pkgdesc="LGTM OS desktop integration: run .exe/.apk like native apps, Mac-style glass desktop"
arch=('any')
license=('GPL-3.0-or-later')
depends=(bash python file git pciutils wl-clipboard grim slurp swaylock keyd plymouth greetd-regreet cage cryptsetup distrobox podman fuse2 flatpak wine umu-launcher icoutils libnotify waydroid polkit
         labwc wayfire waybar swaybg fuzzel foot thunar greetd greetd-tuigreet
         earlyoom zram-generator papirus-icon-theme inter-font wireplumber brightnessctl
         arch-install-scripts gptfdisk dosfstools e2fsprogs squashfs-tools)
optdepends=('gdb: backtraces in crash reports'
            'darling-bin: Mac programs (preview)'
            'whitesur-icon-theme: macOS Graphite theme icons'
            'apple_cursor: macOS Graphite theme cursor'
            'teams-for-linux-bin: Microsoft Teams')
install=lgtm-integration.install
_src=../../../integration

makedepends=(librsvg)

build() {
  # One generated wallpaper per theme (theme.conf: WALLPAPER_STYLE).
  local t
  for t in "$startdir/$_src"/share/lgtm/themes/*/; do
    t=${t%/}
    python "$startdir/$_src/tools/make-wallpaper.py" "$srcdir/wallpaper-${t##*/}.png" 1920 1080 \
      "$(. "$t/theme.conf"; echo "$WALLPAPER_STYLE")"
  done
  # Boot splash images from SVG.
  local p="$startdir/$_src/share/plymouth/lgtm"
  rsvg-convert -w 96 -h 96 "$startdir/$_src/share/lgtm/lgtm-logo.svg" -o "$srcdir/logo.png"
  rsvg-convert "$p/dot.svg" -o "$srcdir/dot.png"
  rsvg-convert "$p/entry.svg" -o "$srcdir/entry.png"
}

package() {
  local s="$startdir/$_src"
  install -Dm755 -t "$pkgdir/usr/bin" "$s"/bin/*
  install -d "$pkgdir/usr/share"
  cp -r "$s/share/lgtm" "$pkgdir/usr/share/lgtm"
  local w
  for w in "$srcdir"/wallpaper-*.png; do
    w=${w##*/wallpaper-}; install -Dm644 "$srcdir/wallpaper-$w" "$pkgdir/usr/share/lgtm/themes/${w%.png}/wallpaper.png"
  done
  ln -s themes/aurora/wallpaper.png "$pkgdir/usr/share/lgtm/wallpaper.png"
  local t="$pkgdir/usr/share/plymouth/themes/lgtm"
  install -Dm644 -t "$t" "$s"/share/plymouth/lgtm/lgtm.{plymouth,script} "$srcdir"/{logo,dot,entry}.png
  install -Dm644 -t "$pkgdir/usr/share/applications" "$s"/share/applications/lgtm-{exe,apk,android,install,open,vm,pod,setup,theme}.desktop
  install -Dm644 "$s/share/applications/lgtm-session.desktop" "$pkgdir/usr/share/wayland-sessions/lgtm.desktop"
  install -Dm644 -t "$pkgdir/usr/lib/binfmt.d" "$s"/binfmt.d/*.conf
  install -Dm644 -t "$pkgdir/usr/lib/sysctl.d" "$s"/sysctl.d/*.conf
  install -Dm644 "$s/systemd/zram-generator.conf" "$pkgdir/usr/lib/systemd/zram-generator.conf"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/journald.conf.d" "$s"/systemd/journald.conf.d/*.conf
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system/earlyoom.service.d" "$s"/systemd/system/earlyoom.service.d/*.conf
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" "$s"/systemd/system/*.service
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" "$s"/systemd/user/*
  # Enabled for every user: weekly GE-Proton update.
  install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  ln -s ../lgtm-proton-update.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/lgtm-proton-update.timer"
  ln -s ../lgtm-apps-update.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/lgtm-apps-update.timer"
  install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../lgtm-crash.path "$pkgdir/usr/lib/systemd/user/default.target.wants/lgtm-crash.path"
  ln -s ../lgtm-crash-watch.service "$pkgdir/usr/lib/systemd/user/default.target.wants/lgtm-crash-watch.service"
  # Our notices, including the MIT license of the parts adapted from Omarchy.
  install -Dm644 "$s/../NOTICE.md" "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
  # Agent skills (linked into each agent's skills folder by lgtm-agent / lgtm-session).
  install -d "$pkgdir/usr/share/lgtm/agents"
  cp -r "$s/agents/skills" "$pkgdir/usr/share/lgtm/agents/skills"
  install -Dm644 -t "$pkgdir/usr/share/polkit-1/rules.d" "$s"/polkit/*.rules
  # Default app settings live in their own XDG config dir, which lgtm-session puts
  # first in XDG_CONFIG_DIRS. Never writes into /etc/xdg (owned by foot, fuzzel, ...).
  install -d "$pkgdir/usr/share/lgtm"
  cp -r "$s/xdg" "$pkgdir/usr/share/lgtm/xdg"
}
